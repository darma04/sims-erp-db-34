# ==========================================================================
# ENVIRONMENT CONFIGURATION — SIMS-Software-Isolated-Database-34
# ==========================================================================
# Copy file ini menjadi .env dan sesuaikan nilainya.
# JANGAN commit file .env ke repository!
# ==========================================================================

DEBUG=False
DJANGO_ENVIRONMENT="production"
SECRET_KEY=GANTI_DENGAN_SECRET_KEY_YANG_KUAT

# Base URL aplikasi (sesuaikan dengan domain production)
BASE_URL=https://your-domain.com

# Allowed Hosts (pisahkan dengan koma)
ALLOWED_HOSTS=your-domain.com,www.your-domain.com
CSRF_TRUSTED_ORIGINS=https://your-domain.com,https://www.your-domain.com

# ==========================================================================
# Database Configuration
# ==========================================================================
DATABASE_ENGINE=postgresql
DB_NAME=sims_db
DB_USER=your_db_user
DB_PASSWORD=your_strong_password
DB_HOST=localhost
DB_PORT=5432
DB_CONN_MAX_AGE=600

# ==========================================================================
# Cache Configuration
# ==========================================================================
CACHE_BACKEND=redis
REDIS_URL=redis://127.0.0.1:6379/1
